# ==========================================
# NutriLens Environment Variables (Example)
# ==========================================

# Application
APP_NAME=NutriLens
DEBUG=false
API_V1_PREFIX=/api

# Database Configuration
# Default for zero-setup local dev: sqlite:///./nutrilens.db
# Production / PostgreSQL container: postgresql://nutrilens_user:nutrilens_password@localhost:5432/nutrilens_db
DATABASE_URL=sqlite:///./nutrilens.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Vision Provider Configuration
# Options: placeholder (Phase 1), gemini (Phase 2), openai (Phase 2)
AI_PROVIDER=placeholder

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=10485760
