# ========================================================
# NutriLens — Zero-Cost Architecture Environment Template
# ========================================================
# Target Cost: ₹0/month initially
# Architecture:
#   1. Frontend: Vercel (Hobby Free Tier)
#   2. Backend:  Render Web Service (Free Tier)
#   3. Database: Neon Serverless PostgreSQL (Permanent Free Tier)
# ========================================================

# --------------------------------------------------------
# A. VERCEL FRONTEND CONFIGURATION (Set in Vercel Project Dashboard)
# --------------------------------------------------------
# Points frontend client to the deployed backend URL on Render.
# IMPORTANT: All VITE_* variables are public in client JavaScript bundles.
# NEVER place private secrets or database keys here!
VITE_API_BASE_URL=https://nutrilens-backend.onrender.com/api


# --------------------------------------------------------
# B. RENDER BACKEND CONFIGURATION (Set in Render Dashboard / Environment)
# --------------------------------------------------------
# Hardened environment mode (enforces strict credential validation)
ENVIRONMENT=staging

# Authentication Secret (REQUIRED)
# Must be at least 32 characters long.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_minimum_32_chars_here

# Neon Serverless PostgreSQL Connection String (REQUIRED)
# Copy from your Neon Console (https://console.neon.tech/)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://nutrilens_user:your_secure_password_here@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (REQUIRED)
# Whitelist only your Vercel frontend domain (no trailing slash, no wildcards).
CORS_ORIGINS=https://nutrilens.vercel.app


# --------------------------------------------------------
# C. GOOGLE GEMINI AI CONFIGURATION
# --------------------------------------------------------
AI_PROVIDER=gemini

# Obtain a genuine free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio_here

# Set to true ONLY if performing offline staging smoke tests without Gemini API keys
ALLOW_PLACEHOLDER_AI=false

GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=25.0


# --------------------------------------------------------
# D. OPERATIONAL DEFAULTS
# --------------------------------------------------------
DEBUG=false
APP_NAME=NutriLens
API_V1_PREFIX=/api
RATE_LIMIT_ANALYZE_PER_MINUTE=15
MAX_UPLOAD_SIZE_BYTES=10485760
IMAGE_RETENTION_SECONDS=86400
