APP_NAME=NutriLens
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api
JWT_SECRET_KEY=nutrilens-secret-key-change-in-production
RATE_LIMIT_ANALYZE_PER_MINUTE=15
DATABASE_URL=sqlite:///./nutrilens.db
# For PostgreSQL:
# DATABASE_URL=postgresql://nutrilens_user:nutrilens_password@localhost:5432/nutrilens_db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=25.0
MAX_UPLOAD_SIZE_BYTES=10485760
