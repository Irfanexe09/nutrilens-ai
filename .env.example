# ==========================================
# NutriLens Environment Variables (Example)
# ==========================================

# Application
APP_NAME=NutriLens
DEBUG=false
API_V1_PREFIX=/api
JWT_SECRET_KEY=nutrilens-secret-key-change-in-production

# Database Configuration
# Default for zero-setup local dev: sqlite:///./nutrilens.db
# Production / PostgreSQL container: postgresql://nutrilens_user:nutrilens_password@localhost:5432/nutrilens_db
DATABASE_URL=sqlite:///./nutrilens.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Vision Provider Configuration
# Options: gemini (Phase 2), placeholder
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=25.0

# File Upload Constraints
MAX_UPLOAD_SIZE_BYTES=10485760
