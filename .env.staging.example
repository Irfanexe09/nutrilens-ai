# ========================================================
# NutriLens — Staging Environment Variables Template
# ========================================================
# Copy this template to .env.staging before running in staging:
#   cp .env.staging.example .env.staging
#
# IMPORTANT: Never commit .env.staging or real credentials to version control!
# ========================================================

# --------------------------------------------------------
# 1. REQUIRED CONFIGURATION (Must be set for staging)
# --------------------------------------------------------

# Environment Mode (Enforces production-grade secret guardrails)
ENVIRONMENT=staging

# Authentication Secret (REQUIRED)
# Must be a unique cryptographically random string (minimum 32 characters).
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_minimum_32_chars_here

# Managed Staging Database URL (REQUIRED)
# Provide connection string to your managed PostgreSQL staging instance.
# Example: postgresql://staging_user:secure_password@staging-pg.provider.internal:5432/nutrilens_staging
DATABASE_URL=postgresql://staging_user:generate_strong_password_here@staging-db-host:5432/nutrilens_staging

# Allowed Browser Origins (REQUIRED)
# Explicit comma-separated whitelist of staging origins (no wildcards).
CORS_ORIGINS=https://staging.nutrilens.app,http://localhost:8080

# --------------------------------------------------------
# 2. AI VISION PROVIDER CONFIGURATION
# --------------------------------------------------------

# AI Provider Selection:
#   gemini      - Real multimodal food analysis (requires GEMINI_API_KEY from Google AI Studio)
#   placeholder - Mock provider (requires ALLOW_PLACEHOLDER_AI=true in staging)
AI_PROVIDER=gemini

# Google Gemini API Key (Required if AI_PROVIDER=gemini)
# Provision from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio_here

# Allow placeholder AI in staging for offline/smoke testing without API key
# Set to 'true' ONLY when running staging smoke tests without external API dependencies.
ALLOW_PLACEHOLDER_AI=false

# Gemini Vision Model & Timeout
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_TIMEOUT_SECONDS=30.0
AI_PER_ATTEMPT_TIMEOUT_SECONDS=12.0


# --------------------------------------------------------
# 3. OPTIONAL OPERATIONAL DEFAULTS
# --------------------------------------------------------

DEBUG=false
APP_NAME=NutriLens
API_V1_PREFIX=/api

# Rate Limiting (per client IP per minute on /api/analyze)
RATE_LIMIT_ANALYZE_PER_MINUTE=15

# Upload Security Constraints
MAX_UPLOAD_SIZE_BYTES=10485760
IMAGE_RETENTION_SECONDS=86400

# Container Host Port Bindings (when using Docker Compose)
BACKEND_PORT=8000
STAGING_PORT=8080
