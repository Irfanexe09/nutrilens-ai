# ==========================================
# NutriLens Environment Variables Template
# ==========================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit the .env file with real credentials to version control.

# Application Environment Mode
# Options: development, production, testing
ENVIRONMENT=development
APP_NAME=NutriLens
DEBUG=false
API_V1_PREFIX=/api
RATE_LIMIT_ANALYZE_PER_MINUTE=15

# Security & Authentication
# In production, JWT_SECRET_KEY MUST be a unique, cryptographically random string (minimum 32 characters).
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_minimum_32_chars

# Database Configuration
# Local Zero-Setup Dev: sqlite:///./nutrilens.db
# Docker Compose / Production: postgresql://<user>:<password>@db:5432/<dbname>
POSTGRES_USER=nutrilens_user
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=nutrilens_db
DATABASE_URL=sqlite:///./nutrilens.db

# Host Port Bindings (Docker Compose)
# Note: Database and backend ports bind strictly to host loopback (127.0.0.1) for security.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Permitted Origins (comma-separated browser origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Vision Provider Configuration
# Options:
#   gemini      - Real multimodal food recognition (requires GEMINI_API_KEY from Google AI Studio)
#   placeholder - Offline zero-credential deterministic mock provider for testing/development
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=25.0

# File Upload Security Constraints
MAX_UPLOAD_SIZE_BYTES=10485760
